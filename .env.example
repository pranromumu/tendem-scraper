TS_HEADLESS=true
TS_USER_AGENT=
TS_HTTP_TIMEOUT=20
TS_HTTP_RETRIES=3
TS_DELAY_SECONDS=1.0
TS_PROXY=
TS_PROXY_POOL=
TS_OPENROUTER_API_KEY=
TS_OPENROUTER_MODEL=openai/gpt-4o-mini
TS_OUTDIR=reports
TS_ALLURE_DIR=allure-results
TS_SESSION_DIR=sessions

# Concurrency / crawl safety
TS_CONCURRENCY=4
TS_LINK_CHECK_WORKERS=8
TS_CRAWL_MAX_PAGES=200
TS_CRAWL_SAME_HOST_ONLY=true
TS_CRAWL_RESPECT_ROBOTS=true

# Webhook (Slack or Discord incoming webhook URL)
TS_WEBHOOK_URL=
TS_WEBHOOK_ON=done

# Optional S3 upload
TS_S3_BUCKET=
TS_S3_PREFIX=scrapes/
TS_AWS_REGION=